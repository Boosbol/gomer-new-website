# Salin file ini menjadi .env.local (lokal) dan isi nilainya.
# Di production, isi variabel yang sama lewat dashboard hosting.
# JANGAN commit file .env / .env.local. Nilai di bawah sengaja dikosongkan.
#
# CATATAN: website BISA berjalan tanpa mengisi apa pun di sini. Musik diambil dari Apple Music
# (tanpa kunci) dan video dari feed RSS YouTube (tanpa kunci). Database & rahasia di bawah
# hanya dibutuhkan untuk penyimpanan + sinkronisasi terjadwal + halaman admin.

# ─── Aplikasi ─── PUBLIC (aman dilihat browser; hanya URL situs) ───────────
NEXT_PUBLIC_SITE_URL=https://www.gomerlapudooh.com

# ─── Database (MySQL / MariaDB) ─── SECRET ─────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:3306/NAMA_DATABASE
# Di Hostinger (aplikasi & database di akun yang sama): HOST = 127.0.0.1 (bukan localhost).
# Jika password mengandung karakter khusus (@ : / # ?), ubah jadi bentuk URL-encoded.
DATABASE_URL=
# TLS ke database. Kosong = aktif. Isi false untuk koneksi lokal 127.0.0.1 (Hostinger) atau MySQL di komputer sendiri.
DATABASE_SSL=

# ─── Proteksi endpoint ─── SECRET ──────────────────────────────────────────
# Dipakai cron & pemanggilan manual /api/sync/*. Minimal 24 karakter acak.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
CRON_SECRET=
# Login Basic Auth untuk /admin/sync. Password minimal 12 karakter.
ADMIN_USER=
ADMIN_PASSWORD=

# ─── Opsional ──────────────────────────────────────────────────────────────
# Sumber musik: kosong atau "apple" = Apple Music (tanpa kunci). "spotify" = Spotify (butuh kunci di bawah + Premium).
MUSIC_SOURCE=
# Menimpa ID kanal YouTube di src/config/site.ts (format UCxxxxxxxxxxxxxxxxxxxxxx).
YOUTUBE_CHANNEL_ID=
# true = jika tidak ada cron, halaman yang di-refresh (ISR) memicu sync saat data > 24 jam (cooldown 1 jam).
ENABLE_STALE_SYNC=false

# ─── Spotify ─── HANYA jika MUSIC_SOURCE=spotify ── SECRET (server only) ───
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Opsional; hanya jika Client Credentials ditolak Spotify (lihat README).
SPOTIFY_REFRESH_TOKEN=

# ─── Integrasi mendatang (BELUM dipakai — jangan diisi sebelum integrasinya dibuat) ───
# INSTAGRAM_ACCESS_TOKEN=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# FACEBOOK_PAGE_ACCESS_TOKEN=
