{
  "name": "gomer-lapudooh-web",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "spotify:authorize": "node --env-file=.env.local scripts/spotify-authorize.mjs",
    "sync:music": "tsx --conditions=react-server --env-file=.env.local scripts/sync-local.ts music",
    "sync:social": "tsx --conditions=react-server --env-file=.env.local scripts/sync-local.ts social",
    "audit:secrets": "bash scripts/audit-secrets.sh"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.0",
    "mysql2": "^3.11.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
